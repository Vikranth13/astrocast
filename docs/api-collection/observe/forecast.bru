meta {
  name: Forecast for a city
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/forecast?city=New Brunswick
  body: none
  auth: none
}

params:query {
  city: New Brunswick
}

docs {
  Local stargazing forecast and score, with the factor breakdown, every scored hour of the observing night, and the best window. Calls Open-Meteo live.
}
